{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "baseBranchPatterns": [
    "staging"
  ],
  "schedule": [
    "at any time"
  ],
  "automerge": true,
  "automergeType": "pr",
  "prHourlyLimit": 0,
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Every flake input inside flake.lock: keep it one PR, or each automerge into staging invalidates its siblings and every rebase rebuilds both hosts in CI",
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake inputs"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "podman container images declared in NixOS modules",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>(?:[a-z0-9][a-z0-9.-]*\\.[a-z]{2,}(?::\\d+)?/)?[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9._-]*)+):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
